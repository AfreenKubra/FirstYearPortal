# ---------------------------------------------------------------------------
# Supabase — copy to `.env.local` and fill in from your Supabase project's
# Settings → API page. `.env.local` is gitignored; never commit real values.
#
# Put real keys in `.env.local`, NOT in this file. This one is a committed
# template — anything written here is shared with everyone who gets the repo.
# ---------------------------------------------------------------------------

# Public by design — these ship in the client bundle and are safe to expose,
# because every query they make is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_, never
# import into a Client Component. Used only for the narrow, audited admin
# operations described in ARCHITECTURE.md section 1.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Optional — the roadmap feature works without it, falling back
# to the rule-based generator (PRD 5.10's "must never simply fail"). Set this
# to switch a student's roadmap to the Claude-backed generator
# (src/lib/roadmap/ai-generate.ts). See MANUAL-STEPS.md 3.1/3.4.
# ANTHROPIC_API_KEY=
# Optional. Overrides the default Claude model (ai-generate.ts's
# DEFAULT_MODEL) without a code change.
# ANTHROPIC_MODEL=
